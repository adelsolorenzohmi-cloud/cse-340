<%- include('partials/header') %>

    <main class="project-details">
        <h1>
            <%= project.project_title %>
        </h1>
        <p>
            <%= project.project_description %>
        </p>

        <div class="project-info">
            <p><strong>Date:</strong>
                <%= project.project_date %>
            </p>
            <p><strong>Location:</strong>
                <%= project.project_location %>
            </p>
            <p><strong>Organized by:</strong>
                <%= project.organization_name %>
            </p>
        </div>

        <h3>Categories</h3>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <%= category.category_name %>
                </li>
                <% }) %>
        </ul>

        <div class="project-actions">
            <% if (isLoggedIn) { %>
                <% if (user.role==='admin' ) { %>
                    <a href="/edit-project/<%= project.project_id %>" class="btn-primary">Edit Project</a>
                    <a href="/project/<%= project.project_id %>/assign-categories" class="btn-secondary">Edit
                        Categories</a>
                    <% } %>

                        <% if (isVolunteering) { %>
                            <p>You are volunteering for this project.</p>
                            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                <button type="submit" class="btn-secondary">Remove Volunteer Status</button>
                            </form>
                            <% } else { %>
                                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                    <button type="submit" class="btn-primary">Volunteer for this Project</button>
                                </form>
                                <% } %>
                                    <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>