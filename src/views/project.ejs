<%- include('partials/header') %>

    <main class="project-details">
        <h1>
            <%= project.title %>
        </h1>

        <p class="description">
            <%= project.description %>
        </p>

        <ul class="meta-info">
            <li><strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString() %>
            </li>
            <li><strong>Location:</strong>
                <%= project.location %>
            </li>
            <li>
                <strong>Organized by:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </li>
        </ul>

        <% if (categories && categories.length> 0) { %>
            <div class="project-categories">
                <h3>Categories</h3>
                <div class="tags">
                    <% categories.forEach(function(category) { %>
                        <a href="/category/<%= category.category_id %>" class="tag">
                            <%= category.category_name %>
                        </a>
                        <% }); %>
                </div>
            </div>
            <% } %>

                <div class="project-actions" style="margin-top: 30px;">
                    <a href="/project/<%= project.project_id %>/assign-categories" class="btn-edit">Edit Categories</a>
                </div>
    </main>

    <%- include('partials/footer') %>