<%- include('partials/header') %>

    <main class="project-details">

        <h1>
            <%= project.title %>
        </h1>

        <p class="description">
            <%= project.description %>
        </p>

        <ul class="org-list">
            <li class="org-card">
                <strong>Date</strong>
                <span>
                    <%= new Date(project.date).toLocaleDateString() %>
                </span>
            </li>
            <li class="org-card">
                <strong>Location</strong>
                <span>
                    <%= project.location %>
                </span>
            </li>
            <li class="org-card">
                <strong>Organized by</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </li>
        </ul>

        <% if (categories && categories.length> 0) { %>
            <div class="project-categories">
                <h3>Categories</h3>
                <div class="tags">
                    <% categories.forEach(function(category) { %>
                        <a href="/category/<%= category.category_id %>" class="tag">
                            <%= category.category_name %>
                        </a>
                        <% }); %>
                </div>
            </div>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <div class="project-actions">
                        <a href="/edit-project/<%= project.project_id %>" class="btn-primary">Edit Project</a>
                        <a href="/project/<%= project.project_id %>/assign-categories" class="btn-secondary">Edit
                            Categories</a>
                    </div>
                    <% } %>
    </main>

    <%- include('partials/footer') %>