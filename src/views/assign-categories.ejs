<%- include('partials/header') %>

    <main class="form-container" style="max-width: 600px; margin: 40px auto; padding: 0 20px;">
        <h1>
            <%= projectDetails.title %>
        </h1>
        <h2>Assign Categories</h2>

        <form action="/project/<%= projectId %>/assign-categories" method="POST">

            <div class="form-group" style="display: flex; flex-direction: column; gap: 12px; margin: 20px 0;">
                <% categories.forEach(category=> { %>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds"
                            value="<%= category.category_id %>" <%=assignedCategories.some(ac=> ac.category_id ===
                        category.category_id) ? 'checked' : '' %>
                        />
                        <label for="category-<%= category.category_id %>" style="font-size: 1.1rem; cursor: pointer;">
                            <%= category.category_name %>
                        </label>
                    </div>
                    <% }); %>
            </div>

            <button type="submit" style="padding: 10px 20px; font-size: 1rem; cursor: pointer; margin-top: 10px;">
                Update Categories
            </button>
        </form>
    </main>

    <%- include('partials/footer') %>