<%- include('partials/header') %>

    <main>
        <% if (user && user.role_name==='admin' ) { %>
            <div class="page-header">
                <div class="page-header__titles">
                    <h1>
                        <%= title %>
                    </h1>
                    <p>Here are a few of our partner organizations:</p>
                </div>
                <a href="/new-organization" class="btn-primary">+ Add New Organization</a>
            </div>
            <% } else { %>
                <h1>
                    <%= title %>
                </h1>
                <p>Here are a few of our partner organizations:</p>
                <% } %>

                    <ul class="org-list">
                        <% organizations.forEach(organization=> { %>
                            <li class="org-card">
                                <img src="/images/<%= organization.logo_filename %>"
                                    alt="<%= organization.name %> logo">

                                <a href="/organization/<%= organization.organization_id %>" class="org-name">
                                    <%= organization.name %>
                                </a>

                                <p class="org-description">
                                    <%= organization.description %>
                                </p>

                                <span class="org-contact">
                                    <a href="mailto:<%= organization.contact_email %>">
                                        <%= organization.contact_email %>
                                    </a>
                                </span>
                            </li>
                            <% }); %>
                    </ul>
    </main>

    <%- include('partials/footer') %>